<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- 0.1.0-*: the newest build that scripts/pack-local.sh put in tmp/feed. A consumer pins a
         release version instead. -->
    <PackageReference Include="Extrode.Pare.Build" Version="0.1.0-*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Web SDK publishes root .json and .config files; these are build inputs only. -->
    <Content Update="tsconfig.json;nuget.config" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
