<Project Sdk="Microsoft.NET.Sdk">
  <!-- Slow: real `dotnet build`/`publish` on temp projects, the sample app in headless Chromium. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Extrode.Pare.Build\Extrode.Pare.Build.csproj" />
    <!-- Built first; the CLI sample tests run its pare.dll. -->
    <ProjectReference Include="..\..\src\Extrode.Pare.Cli\Extrode.Pare.Cli.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first; a test app references its dll. -->
    <ProjectReference Include="..\..\src\Extrode.Pare.AspNetCore\Extrode.Pare.AspNetCore.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
