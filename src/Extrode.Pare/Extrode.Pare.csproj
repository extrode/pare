<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Extrode.Pare</RootNamespace>
    <PackageId>Extrode.Pare</PackageId>
    <Description>TypeScript type stripper: overwrites type syntax with spaces, so the JavaScript keeps every line and column. No allocation per call, NativeAOT-compatible, no dependencies.</Description>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>typescript;type-stripping;nativeaot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE.md;..\..\NOTICE.md;..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Extrode.Pare.Tests" />
    <InternalsVisibleTo Include="Extrode.Pare.Conformance" />
  </ItemGroup>
</Project>
