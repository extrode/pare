<Project>
  <!-- Output: in a project with static web assets (the Web SDK), each wwwroot source's output goes
       under $(IntermediateOutputPath)pare/ and is registered as a static web asset at the source's
       path below wwwroot; outputs whose source is gone are deleted. A source with PareServeAt
       metadata (a URL folder, `/` for the root) is served there instead, wherever it sits:
       folder + %(RecursiveDir) + its name with .ts, .mts, .cts made .js, .mjs, .cjs. Elsewhere,
       and for other sources outside wwwroot (PARE202), output goes next to each source.
       Properties:
         PareOutDir         write output under this directory (relative paths kept) instead; turns
                            off the obj/ output
         PareTypeCheck      true type-checks with tsc (noEmit, -p PareTsconfig) before the strip
         PareTscPath        TypeScript 7 native tsc, default `tsc` on PATH
         PareTsconfig       default tsconfig.json in the project directory; a build input, never
                            copied to the output or publish directory
         PareKeepSources    true keeps .ts and .d.ts files in Content, so they are served and
                            published next to the output
         PareEmbed          true embeds every output in the assembly instead: written under
                            $(IntermediateOutputPath)pare/ (or PareOutDir) at its path below the
                            project, named $(PareEmbedPrefix) + that path; never Content or a
                            static web asset
       Another compile-to-JavaScript step (another package) declares its sources as PareCompileSource
       items with PareCompiler (its name) and PareOutputExtension (`.svelte.js`: the output is
       %(Filename) + it), PareServeAt optional; a second output of one source is a second item. They
       are placed, served, embedded, published, deleted and checked (PARE201-205) as TypeScript
       sources are. Every file the compiler writes under obj/ is one of these outputs: Pare deletes
       any other file there as stale. Its targets go in PareCompileDependsOn and run after the strip, where each
       @(PareCompileSource) has PareOutputPath (write the output there) and PareRelativePath.
       After PareStripTypeScript, @(PareOutput) lists the outputs, with PareSource (the source's
       full path), PareRelativePath (the URL or embedded name; else the path below the project)
       and, for a compiled source, PareCompiler.
         PareTaskAssembly   the task dll; tests point it at a build output -->
  <PropertyGroup>
    <PareTaskAssembly Condition="'$(PareTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\tasks\net10.0\Extrode.Pare.Build.dll</PareTaskAssembly>
    <PareTsconfig Condition="'$(PareTsconfig)' == ''">$(MSBuildProjectDirectory)\tsconfig.json</PareTsconfig>
    <_PareTsconfigPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PareTsconfig)'))</_PareTsconfigPath>
    <_PareOutRoot Condition="'$(PareOutDir)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PareOutDir)'))</_PareOutRoot>
  </PropertyGroup>

  <!-- The task targets .NET. Visual Studio's MSBuild (.NET Framework) runs it in MSBuild 18's
       .NET task host, out of process. -->
  <UsingTask TaskName="Extrode.Pare.Build.StripTypeScript" AssemblyFile="$(PareTaskAssembly)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="Extrode.Pare.Build.StripTypeScript" AssemblyFile="$(PareTaskAssembly)"
             Runtime="NET" TaskFactory="TaskHostFactory" Condition="'$(MSBuildRuntimeType)' != 'Core'" />
  <UsingTask TaskName="Extrode.Pare.Build.LogPareDiagnostics" AssemblyFile="$(PareTaskAssembly)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="Extrode.Pare.Build.LogPareDiagnostics" AssemblyFile="$(PareTaskAssembly)"
             Runtime="NET" TaskFactory="TaskHostFactory" Condition="'$(MSBuildRuntimeType)' != 'Core'" />
  <UsingTask TaskName="Extrode.Pare.Build.WriteDevelopmentMap" AssemblyFile="$(PareTaskAssembly)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="Extrode.Pare.Build.WriteDevelopmentMap" AssemblyFile="$(PareTaskAssembly)"
             Runtime="NET" TaskFactory="TaskHostFactory" Condition="'$(MSBuildRuntimeType)' != 'Core'" />

  <Target Name="_PareComputeOutputs">
    <!-- In a target: IntermediateOutputPath is not set yet when a package's files are evaluated. -->
    <PropertyGroup>
      <_PareObjRoot Condition="('$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true' or '$(PareEmbed)' == 'true') and '$(_PareOutRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'pare'))</_PareObjRoot>
    </PropertyGroup>
    <!-- A TypeScript source declared twice (a package's .props and the project file) is one source;
         the SDK would crash on its duplicate asset. (A compile source twice is two outputs.) RemoveDuplicates returns new items without the
         wildcard's RecursiveDir, so that is copied into metadata first. -->
    <ItemGroup>
      <_PareTypeScriptSourceAll Include="@(TypeScriptSource)">
        <_PareRecursiveDir>%(RecursiveDir)</_PareRecursiveDir>
      </_PareTypeScriptSourceAll>
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_PareTypeScriptSourceAll)">
      <Output TaskParameter="Filtered" ItemName="_PareTypeScriptSource" />
    </RemoveDuplicates>
    <ItemGroup>
      <_PareSource Include="@(_PareTypeScriptSource)"
                   Condition="('%(Extension)' == '.ts' or '%(Extension)' == '.mts' or '%(Extension)' == '.cts') and !$([System.String]::Copy('%(Filename)').EndsWith('.d'))" />
      <!-- A compiler is a name; an extension is a dot and a name, with no folder in it. Either goes
           into the development map's JSON as is. Marked per item: an Exclude would also drop a valid
           item with the same Include. -->
      <_PareCompileCandidate Include="@(PareCompileSource)">
        <_PareRecursiveDir>%(RecursiveDir)</_PareRecursiveDir>
      </_PareCompileCandidate>
      <_PareCompileCandidate Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(_PareCompileCandidate.PareCompiler)', '^[A-Za-z0-9._-]+\z')) or !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_PareCompileCandidate.PareOutputExtension)', '^\.[^/\\&quot;]+\z'))">
        <_PareBad>true</_PareBad>
      </_PareCompileCandidate>
      <_PareBadCompile Include="@(_PareCompileCandidate)" Condition="'%(_PareCompileCandidate._PareBad)' == 'true'" />
      <_PareSource Include="@(_PareCompileCandidate)" Condition="'%(_PareCompileCandidate._PareBad)' != 'true'">
        <_PareCompiled>true</_PareCompiled>
      </_PareSource>
      <_PareSource>
        <_PareDir>$([MSBuild]::MakeRelative('$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory)))', '%(RootDir)%(Directory)').Replace('\', '/'))</_PareDir>
        <_PareJs>%(Filename)$([System.String]::Copy('%(Extension)').Replace('ts', 'js'))</_PareJs>
        <_PareSourceSpec>%(Identity)</_PareSourceSpec>
        <_PareServeAt>$([System.String]::Copy('%(_PareSource.PareServeAt)').Replace('\', '/'))</_PareServeAt>
      </_PareSource>
      <_PareSource Condition="'%(_PareSource._PareCompiled)' == 'true'">
        <_PareJs>%(_PareSource.Filename)%(_PareSource.PareOutputExtension)</_PareJs>
      </_PareSource>
      <!-- A folder, never a file: no `.`/`..` segment, `:`, `//` or script extension. -->
      <_PareBadServeAt Include="@(_PareSource)"
                       Condition="'%(_PareSource._PareServeAt)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.String]::Copy('%(_PareSource._PareServeAt)').ToLowerInvariant()), ':|//|(^|/)\.\.?(/|\z)|\.[mc]?[jt]s/*\z'))" />
      <!-- PareRelativePath, when also set, wins. `/` is the root: mapped is decided before trimming. -->
      <_PareSource Condition="'%(_PareSource._PareServeAt)' != '' and '%(_PareSource.PareRelativePath)' == ''">
        <_PareFolder>$([System.String]::Copy('%(_PareSource._PareServeAt)').Trim('/'))</_PareFolder>
      </_PareSource>
      <_PareSource Condition="'%(_PareSource._PareFolder)' != ''">
        <_PareFolder>%(_PareSource._PareFolder)/</_PareFolder>
      </_PareSource>
      <_PareSource Condition="'%(_PareSource._PareServeAt)' != '' and '%(_PareSource.PareRelativePath)' == ''">
        <PareRelativePath>%(_PareSource._PareFolder)%(_PareSource._PareRecursiveDir)%(_PareSource._PareJs)</PareRelativePath>
      </_PareSource>
      <_PareSource Condition="'$(PareEmbed)' == 'true' and '%(_PareSource.PareRelativePath)' == ''">
        <PareRelativePath>%(_PareDir)%(_PareJs)</PareRelativePath>
      </_PareSource>
      <_PareSource Condition="'$(_PareObjRoot)' != '' and '%(_PareSource.PareRelativePath)' == '' and $([System.String]::Copy('%(_PareDir)').StartsWith('wwwroot/'))">
        <PareRelativePath>$([System.String]::Copy('%(_PareDir)').Substring(8))%(_PareJs)</PareRelativePath>
      </_PareSource>
      <!-- A URL path: %(RecursiveDir) in a mapping is `lib\` on Windows. -->
      <_PareSource Condition="'%(_PareSource.PareRelativePath)' != ''">
        <PareRelativePath>$([System.String]::Copy('%(_PareSource.PareRelativePath)').Replace('\', '/'))</PareRelativePath>
      </_PareSource>
      <_PareSource Condition="'%(_PareSource.PareRelativePath)' != ''">
        <PareOutputPath>$(_PareObjRoot)%(_PareSource.PareRelativePath)</PareOutputPath>
      </_PareSource>
      <!-- Relative like the source item: static web assets match wwwroot/** against the item spec. -->
      <_PareSource Condition="'%(_PareSource.PareRelativePath)' == '' and '$(_PareOutRoot)' == ''">
        <PareOutputPath>%(RelativeDir)%(_PareJs)</PareOutputPath>
      </_PareSource>
      <_PareSource Condition="'$(_PareOutRoot)' != ''">
        <PareOutputPath>$(_PareOutRoot)%(RelativeDir)%(_PareJs)</PareOutputPath>
      </_PareSource>
      <!-- Two sources at one URL: the SDK would crash on the duplicate asset (MSB4018). Batches
           group case-insensitively, as one obj/ file on macOS and Windows would. -->
      <_PareUrl Include="@(_PareSource->'%(PareRelativePath)')" Condition="'%(_PareSource.PareRelativePath)' != ''" />
      <!-- Outside wwwroot with no URL: written next to the source, which serves nothing. A
           .razor.js or .cshtml.js there is the SDK's collocated JS, which it serves itself. -->
      <_PareUnserved Include="@(_PareSource)"
                     Condition="'$(_PareObjRoot)' != '' and '%(_PareSource.PareRelativePath)' == '' and !$([System.String]::Copy('%(_PareSource._PareJs)').EndsWith('.razor.js')) and !$([System.String]::Copy('%(_PareSource._PareJs)').EndsWith('.cshtml.js'))" />
      <!-- A source above the project folder would land above PareOutDir too. -->
      <_PareOutside Include="@(_PareSource)"
                    Condition="'$(_PareOutRoot)' != '' and ('%(_PareSource._PareDir)' == '../' or $([System.String]::Copy('%(_PareSource._PareDir)').StartsWith('../')))" />
      <_PareStripSource Include="@(_PareSource)" Condition="'%(_PareSource._PareCompiled)' != 'true'" />
      <!-- Handed back with PareOutputPath and PareRelativePath, for the targets in PareCompileDependsOn. -->
      <PareCompileSource Remove="@(PareCompileSource)" />
      <PareCompileSource Include="@(_PareSource)" Condition="'%(_PareSource._PareCompiled)' == 'true'" />
    </ItemGroup>
    <LogPareDiagnostics Items="@(_PareOutside)" Code="PARE205" Condition="'@(_PareOutside)' != ''"
           Text="the source is outside the project folder, so its output would be written outside PareOutDir=&quot;$(PareOutDir)&quot;. Move the source into the project, or build it from the project that owns it." />
    <LogPareDiagnostics Items="@(_PareBadCompile)" Code="PARE204" Condition="'@(_PareBadCompile)' != ''"
           Text="PareCompileSource needs PareCompiler (the compiler's name: letters, digits, . _ -) and PareOutputExtension (the output's extension, a dot and a name such as .svelte.js); got PareCompiler=&quot;{PareCompiler}&quot; PareOutputExtension=&quot;{PareOutputExtension}&quot;." />
    <LogPareDiagnostics Items="@(_PareBadServeAt)" Code="PARE203" Condition="'@(_PareBadServeAt)' != ''"
           Text="PareServeAt=&quot;{PareServeAt}&quot; is not a URL folder. Give a folder such as js, or / for the root, with no . or .. segment, colon, double slash or file name: the file name comes from the source." />
    <Error Code="PARE201" File="$(MSBuildProjectFullPath)" Condition="'@(_PareUrl->Count())' &gt; '1'"
           Text="two sources map to one URL, %(_PareUrl.Identity): @(_PareUrl->'%(_PareSourceSpec)', ', '). Serve one under a different PareServeAt folder, or remove one from its item." />
    <Warning Code="PARE202" File="%(_PareUnserved.Identity)" Condition="'@(_PareUnserved)' != ''"
             Text="not served: outside wwwroot with no PareServeAt, so the .js goes next to the source and is not a static web asset. Add PareServeAt=&quot;js&quot; to its item to serve it under js/, or add PARE202 to NoWarn to keep it as is." />
  </Target>

  <Target Name="PareTypeCheck" DependsOnTargets="_PareComputeOutputs"
          Condition="'$(PareTypeCheck)' == 'true' and '@(TypeScriptSource)' != ''">
    <Exec Command="&quot;$(PareTscPath)&quot; --noEmit -p &quot;$(PareTsconfig)&quot;" />
  </Target>

  <!-- No body, so a project's AfterTargets="PareStripTypeScript" sees @(PareOutput): a project's
       own targets are declared before a package's, and AfterTargets run in declaration order. -->
  <Target Name="PareStripTypeScript" BeforeTargets="BeforeBuild"
          DependsOnTargets="_PareComputeOutputs;PareTypeCheck;_PareStrip;$(PareCompileDependsOn);_PareRegisterOutputs" />

  <!-- Incremental: an output is rewritten only when its source, the task or this file is newer. -->
  <Target Name="_PareStrip" DependsOnTargets="_PareComputeOutputs"
          Condition="'@(TypeScriptSource)' != ''"
          Inputs="@(_PareStripSource);$(PareTaskAssembly);$(MSBuildThisFileFullPath)"
          Outputs="@(_PareStripSource->'%(PareOutputPath)')">
    <StripTypeScript Sources="@(_PareStripSource)" ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- Runs even when the strip was skipped as up to date. Outputs join Content so static web
       assets serve and publish them, including on the first build when evaluation-time globs
       could not see them yet. Sources leave Content here rather than at evaluation, where a
       package's targets may be imported before the Web SDK adds wwwroot/**. -->
  <Target Name="_PareRegisterOutputs" Condition="'@(_PareSource)' != ''">
    <ItemGroup>
      <PareOutput Include="@(_PareSource->'%(PareOutputPath)')">
        <PareSource>%(_PareSource.FullPath)</PareSource>
      </PareOutput>
      <PareOutput Condition="'%(PareOutput.PareRelativePath)' == ''">
        <PareRelativePath>%(PareOutput._PareDir)%(PareOutput._PareJs)</PareRelativePath>
      </PareOutput>
      <FileWrites Include="@(PareOutput)" />
      <EmbeddedResource Include="@(PareOutput)" LogicalName="$(PareEmbedPrefix)%(PareOutput.PareRelativePath)"
                        WithCulture="false" Condition="'$(PareEmbed)' == 'true'" />
      <_PareContentOutput Include="@(_PareSource->'%(PareOutputPath)')" Condition="'%(_PareSource.PareRelativePath)' == ''" />
      <Content Remove="@(_PareContentOutput)" />
      <Content Include="@(_PareContentOutput)" />
      <!-- A .razor.js or .cshtml.js under PareOutDir has no component beside it: as Content or None
           (the Web SDK's glob, from the second build) the SDK fails the build with BLAZOR106. -->
      <_PareOutDirCollocated Include="@(_PareSource->'%(PareOutputPath)')"
                             Condition="'$(_PareOutRoot)' != '' and ($([System.String]::Copy('%(_PareSource._PareJs)').EndsWith('.razor.js')) or $([System.String]::Copy('%(_PareSource._PareJs)').EndsWith('.cshtml.js')))" />
      <!-- Also relative: the SDK's globs name files relative to the project, and Remove matches the spec. -->
      <_PareOutDirCollocated Condition="'@(_PareOutDirCollocated)' != ''" Include="@(_PareOutDirCollocated->'$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)$([System.IO.Path]::DirectorySeparatorChar)', '%(FullPath)'))')" />
      <Content Remove="@(_PareOutDirCollocated)" />
      <None Remove="@(_PareOutDirCollocated)" />
      <!-- A .js beside a source whose output is in obj/: left by Pare 0.2 or hand-written. As
           Content it would be a second asset at the same path, which the SDK rejects; a
           .razor.js is also found as None (collocated JS). Not the source itself: a compiled
           source may keep its name (x.svelte.js to x.svelte.js, a page to a page). -->
      <_PareShadowed Include="@(_PareSource->'%(RelativeDir)%(_PareJs)')"
                     Condition="'$(PareEmbed)' != 'true' and '%(_PareSource.PareRelativePath)' != '' and '%(_PareSource._PareJs)' != '%(_PareSource.Filename)%(_PareSource.Extension)' and Exists('%(_PareSource.RelativeDir)%(_PareSource._PareJs)')" />
      <Content Remove="@(_PareShadowed)" />
      <None Remove="@(_PareShadowed)" />
      <Content Remove="@(TypeScriptSource);@(PareCompileSource);wwwroot/**/*.d.ts;wwwroot/**/*.d.mts;wwwroot/**/*.d.cts"
               Condition="'$(PareKeepSources)' != 'true'" />
      <!-- The Web SDK makes every root .json Content. -->
      <Content Condition="'%(FullPath)' == '$(_PareTsconfigPath)'">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
    <Warning Code="PARE200" File="%(_PareShadowed.Identity)" Condition="'@(_PareShadowed)' != ''"
             Text="not served: the build now writes this file's output under obj/ and serves that. Delete it." />
  </Target>

  <!-- obj/ output only. Pare owns the directory, so a file no source produces is a deleted
       source's output. The SDK's incremental clean removes only what an earlier build wrote; this
       also removes what AddPareDevelopment wrote. Runs with no sources left too. -->
  <Target Name="_PareDeleteStaleOutputs" AfterTargets="PareStripTypeScript" BeforeTargets="BeforeBuild" DependsOnTargets="_PareComputeOutputs"
          Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true' and '$(_PareOutRoot)' == ''">
    <ItemGroup Condition="'$(_PareObjRoot)' != ''">
      <_PareObjOutput Include="@(_PareSource->'%(PareOutputPath)')" Condition="'%(_PareSource.PareRelativePath)' != ''" />
      <_PareStale Include="$(_PareObjRoot)**" Exclude="@(_PareObjOutput)" />
    </ItemGroup>
    <Delete Files="@(_PareStale)" />
  </Target>

  <!-- Registered like scoped CSS (_ComputeScopedCssStaticWebAssets): computed assets in the inputs
       stage, so the SDK compresses and fingerprints them like files in wwwroot. -->
  <PropertyGroup>
    <ResolveStaticWebAssetsInputsDependsOn>$(ResolveStaticWebAssetsInputsDependsOn);_PareDefineStaticWebAssets</ResolveStaticWebAssetsInputsDependsOn>
  </PropertyGroup>

  <Target Name="_PareDefineStaticWebAssets" DependsOnTargets="ResolveStaticWebAssetsConfiguration;_PareComputeOutputs">
    <ItemGroup>
      <_PareAssetCandidate Include="@(_PareSource->'%(PareOutputPath)')" Condition="'$(PareEmbed)' != 'true' and '%(_PareSource.PareRelativePath)' != ''">
        <!-- No OriginalItemSpec: compression reads the file it names, which must be the output. -->
        <RelativePath>%(_PareSource.PareRelativePath)</RelativePath>
      </_PareAssetCandidate>
    </ItemGroup>
    <DefineStaticWebAssets Condition="'@(_PareAssetCandidate)' != ''"
      CandidateAssets="@(_PareAssetCandidate)"
      SourceType="Computed"
      SourceId="$(PackageId)"
      ContentRoot="$(_PareObjRoot)"
      BasePath="$(StaticWebAssetBasePath)"
      AssetKind="All"
      AssetMode="All"
      AssetRole="Primary"
      AssetMergeSource="$(StaticWebAssetMergeTarget)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      CopyToOutputDirectory="Never"
      CopyToPublishDirectory="PreserveNewest">
      <Output TaskParameter="Assets" ItemName="_PareStaticWebAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints Condition="'@(_PareStaticWebAsset)' != ''"
      CandidateAssets="@(_PareStaticWebAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_PareStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
    <ItemGroup>
      <StaticWebAsset Include="@(_PareStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_PareStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

  <!-- Tells AddPareDevelopment where sources and outputs are: wwwroot's, and each mapped source's
       (PareServeAt included). In the build output, never in a publish: as
       Extrode.Pare.development.json, and as Extrode.Pare.development.<project>.json, which also
       reaches the output of every project referencing this one (a Razor class library's sources). -->
  <Target Name="_PareComputeDevelopmentMap" DependsOnTargets="_PareComputeOutputs"
          Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true' and '$(_PareOutRoot)' == '' and '$(PareEmbed)' != 'true' and '$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <_PareMapSource Include="@(_PareSource->'%(FullPath)')" Condition="'%(_PareSource.PareRelativePath)' != '' and '%(_PareSource._PareCompiled)' != 'true'" />
      <_PareMapCompiled Include="@(_PareSource->'%(FullPath)')" Condition="'%(_PareSource.PareRelativePath)' != '' and '%(_PareSource._PareCompiled)' == 'true'" />
    </ItemGroup>
    <PropertyGroup>
      <_PareWebRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot'))</_PareWebRoot>
      <_PareSharedMapPath>$(IntermediateOutputPath)Extrode.Pare.development.json</_PareSharedMapPath>
    </PropertyGroup>
  </Target>

  <Target Name="_PareShareDevelopmentMap" BeforeTargets="AssignTargetPaths" DependsOnTargets="_PareComputeDevelopmentMap"
          Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true' and '$(_PareOutRoot)' == '' and '$(PareEmbed)' != 'true' and '$(_IsPublishing)' != 'true'">
    <WriteDevelopmentMap File="$(_PareSharedMapPath)" SourceRoot="$(_PareWebRoot)" OutputRoot="$(_PareObjRoot)"
                         Sources="@(_PareMapSource)" Compiled="@(_PareMapCompiled)" />
    <ItemGroup>
      <FileWrites Include="$(_PareSharedMapPath)" />
      <None Include="$(_PareSharedMapPath)" Link="Extrode.Pare.development.$(MSBuildProjectName).json"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="_PareWriteDevelopmentMap" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="_PareComputeDevelopmentMap"
          Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true' and '$(_PareOutRoot)' == '' and '$(PareEmbed)' != 'true' and '$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <_PareMapPath>$(OutDir)Extrode.Pare.development.json</_PareMapPath>
    </PropertyGroup>
    <WriteDevelopmentMap File="$(_PareMapPath)" SourceRoot="$(_PareWebRoot)" OutputRoot="$(_PareObjRoot)"
                         Sources="@(_PareMapSource)" Compiled="@(_PareMapCompiled)" />
    <ItemGroup>
      <FileWrites Include="$(_PareMapPath)" />
    </ItemGroup>
  </Target>

  <!-- dotnet watch rebuilds when a source changes, but only with hot reload off (the
       no-hot-reload option): in hot reload mode it treats wwwroot files as static assets and
       does not build. -->
  <ItemGroup>
    <Watch Include="@(TypeScriptSource);@(PareCompileSource)" />
  </ItemGroup>
</Project>
